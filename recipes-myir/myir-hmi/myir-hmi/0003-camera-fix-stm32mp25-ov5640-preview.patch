@@ -50,6 +54,10 @@ int AbstractCamera::init_device(camera_info& in_camera)
     // 像素格式优先级选择
     if(pixformat_l.contains(QString("MJPG")))
         in_camera.pixelformat = V4L2_PIX_FMT_MJPEG;
+    // STM32 DCMIPP RGB16 is little-endian RGB565 (FOURCC RGBP).
+    // It matches the RGB888 media-bus output of the main postprocessor.
+    else if(pixformat_l.contains(QString("RGBP")))
+        in_camera.pixelformat = V4L2_PIX_FMT_RGB565;
     else if(pixformat_l.contains(QString("RGBR")))
         in_camera.pixelformat = V4L2_PIX_FMT_RGB565X;
     else if(pixformat_l.contains(QString("YUYV")))
