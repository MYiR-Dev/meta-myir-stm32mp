+// Disable stale mutable DCMIPP input branches left enabled by another user.
+// The main ISP link is immutable; dump and auxiliary links are mutable.
+static int disableDcmippCompetingLinks(
+    int mediaFd,
+    const QVector<MediaPipeline::TopoEntity> &entities,
+    const QVector<MediaPipeline::TopoPad> &pads,
+    const QVector<MediaPipeline::TopoLink> &links,
+    const QVector<MediaPipeline::PathHop> &path)
+{
+    QSet<unsigned int> pathLinkIds;
+    for (const auto &hop : path) {
+        if (hop.link)
+            pathLinkIds.insert(hop.link->id);
+    }
+
+    auto padById = [&](unsigned int pid) -> const MediaPipeline::TopoPad* {
+        for (const auto &p : pads) if (p.id == pid) return &p;
+        return nullptr;
+    };
+    auto entityById = [&](unsigned int eid) -> const MediaPipeline::TopoEntity* {
+        for (const auto &e : entities) if (e.id == eid) return &e;
+        return nullptr;
+    };
+
+    for (const auto &link : links) {
+        if (!(link.flags & MEDIA_LNK_FL_ENABLED) ||
+            (link.flags & MEDIA_LNK_FL_IMMUTABLE) ||
+            pathLinkIds.contains(link.id))
+            continue;
+
+        const MediaPipeline::TopoPad *sp = padById(link.srcId);
+        const MediaPipeline::TopoPad *dp = padById(link.dstId);
+        if (!sp || !dp)
+            continue;
+        const MediaPipeline::TopoEntity *src = entityById(sp->entityId);
+        const MediaPipeline::TopoEntity *dst = entityById(dp->entityId);
+        if (!src || !dst || src->name != QStringLiteral("dcmipp_input"))
+            continue;
+
+        struct media_link_desc ld;
+        memset(&ld, 0, sizeof(ld));
+        ld.source.entity = src->id;
+        ld.source.index = sp->index;
+        ld.source.flags = MEDIA_PAD_FL_SOURCE;
+        ld.sink.entity = dst->id;
+        ld.sink.index = dp->index;
+        ld.sink.flags = MEDIA_PAD_FL_SINK;
+        ld.flags = 0;
+        if (ioctl(mediaFd, MEDIA_IOC_SETUP_LINK, &ld) < 0) {
+            qCWarning(mpLog, "MP: disable competing link %s->%s failed: %s",
+                      qPrintable(src->name), qPrintable(dst->name), strerror(errno));
+            return -errno;
+        }
+        qCInfo(mpLog, "MP: disabled competing link '%s'->'%s'",
+               qPrintable(src->name), qPrintable(dst->name));
+    }
+    return 0;
+}
