From c1103b7f247ed6d4b5a9c075f1807e21c447269b Mon Sep 17 00:00:00 2001
From: MYIR <support@myirtech.com>
Date: Thu, 22 Oct 2026 17:28:26 +0800
Subject: [PATCH] main: resize fullscreen window after display hotplug

Weston temporarily removes all outputs while switching between HDMI and LVDS.
Coalesce Qt screen events, unmap the stale fullscreen surface, reset it to the
new screen geometry, and remap only after the output has settled.

Keep QML hidden until C++ performs the initial fullscreen mapping. This avoids
competing visibility changes and keeps LVDS at 1024x600 while HDMI uses
1920x1080.

Upstream-Status: Inappropriate [product configuration]

Signed-off-by: MYIR <support@myirtech.com>
---
 main.cpp | 106 +++++++++++++++++++++++++++++++++++++++++++++++++++++--
 main.qml |   9 +----
 2 files changed, 105 insertions(+), 10 deletions(-)

diff --git a/main.cpp b/main.cpp
index 0639df0..3ac94d7 100755
--- a/main.cpp
+++ b/main.cpp
@@ -22,6 +22,8 @@
 
 #include <QApplication>
 #include <QGuiApplication>
+#include <QPointer>
+#include <QScreen>
 #include <QWindow>
 #include <QQmlApplicationEngine>
 #include <QFontDatabase>
@@ -41,6 +43,84 @@
 using namespace std;
 using namespace MQP;
 
+namespace {
+constexpr int displayChangeDelayMs = 500;
+constexpr int displayRemapDelayMs = 150;
+
+class FullScreenSwitcher : public QObject
+{
+public:
+    explicit FullScreenSwitcher(QWindow *window)
+        : QObject(window), m_window(window)
+    {
+        m_settleTimer.setSingleShot(true);
+        m_showTimer.setSingleShot(true);
+        QObject::connect(&m_settleTimer, &QTimer::timeout, this,
+                         [this]() { apply(); });
+        QObject::connect(&m_showTimer, &QTimer::timeout, this,
+                         [this]() { show(); });
+    }
+
+    void watch(QScreen *screen)
+    {
+        QObject::connect(screen, &QScreen::geometryChanged, this,
+                         [this, screen](const QRect &) { schedule(screen); });
+        QObject::connect(screen, &QScreen::availableGeometryChanged, this,
+                         [this, screen](const QRect &) { schedule(screen); });
+    }
+
+    void schedule(QScreen *screen)
+    {
+        m_target = screen;
+        beginTransition();
+        m_settleTimer.start(displayChangeDelayMs);
+    }
+
+    void beginTransition()
+    {
+        m_settleTimer.stop();
+        m_showTimer.stop();
+        if (!m_window || !m_window->isVisible())
+            return;
+
+        m_window->hide();
+        m_window->setWindowState(Qt::WindowNoState);
+    }
+
+private:
+    void apply()
+    {
+        if (!m_window || !m_target || m_target->name().isEmpty() ||
+            !m_target->geometry().isValid())
+            return;
+
+        qInfo() << "Switching fullscreen window to" << m_target->name()
+                << m_target->geometry();
+        m_window->setScreen(m_target);
+        m_window->resize(m_target->geometry().size());
+        m_showTimer.start(displayRemapDelayMs);
+    }
+
+    void show()
+    {
+        if (!m_window || !m_target || m_target->name().isEmpty() ||
+            !m_target->geometry().isValid())
+            return;
+
+        m_window->setScreen(m_target);
+        m_window->resize(m_target->geometry().size());
+        m_window->showFullScreen();
+        qInfo() << "Fullscreen window ready on" << m_target->name()
+                << m_window->size();
+    }
+
+    QPointer<QWindow> m_window;
+    QPointer<QScreen> m_target;
+    QTimer m_settleTimer;
+    QTimer m_showTimer;
+};
+} // namespace
+
 void iconFontInit()
 {
 //
@@ -104,8 +184,30 @@ int main(int argc, char *argv[])
     engine.load(QUrl(QStringLiteral("qrc:/main.qml")));
     if (engine.rootObjects().isEmpty())
         return -1;
-    if (auto *window = qobject_cast<QWindow *>(engine.rootObjects().first()))
-        window->showMaximized();
+    if (auto *window = qobject_cast<QWindow *>(engine.rootObjects().first())) {
+        auto *switcher = new FullScreenSwitcher(window);
+        for (QScreen *screen : QGuiApplication::screens())
+            switcher->watch(screen);
+
+        QObject::connect(&app, &QGuiApplication::screenAdded, switcher,
+                         [switcher](QScreen *screen) {
+            switcher->watch(screen);
+            switcher->schedule(screen);
+        });
+        QObject::connect(&app, &QGuiApplication::screenRemoved, switcher,
+                         [switcher](QScreen *) {
+            switcher->beginTransition();
+            QTimer::singleShot(0, switcher, [switcher]() {
+                switcher->schedule(QGuiApplication::primaryScreen());
+            });
+        });
+
+        if (QScreen *screen = QGuiApplication::primaryScreen()) {
+            window->setScreen(screen);
+            window->resize(screen->geometry().size());
+        }
+        window->showFullScreen();
+    }
 
     if (cameraSelfTest) {
         QTimer::singleShot(1000, show_image, [show_image]() {
